// Phase 0 scaffold. Feature behavior lands in later phases.
// The initial migration enables pgvector; similarity search is Phase 3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MessageAuthor {
  VISITOR
  AGENT
  SYSTEM
}

enum Channel {
  WIDGET
  EMAIL
}

enum Plan {
  STARTER
  PRO
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum IntegrationType {
  SLACK
  GMAIL
  STRIPE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           Membership[]
  invitationsSent       Invitation[]     @relation("InvitedBy")
  assignedConversations Conversation[]   @relation("Assignee")
  messages              Message[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  invitations    Invitation[]
  widgetSettings WidgetSettings?
  conversations  Conversation[]
  tags           Tag[]
  documents      KnowledgeDocument[]
  chunks         DocumentChunk[]
  subscription   Subscription?
  usageCounters  UsageCounter[]
  integrations   Integration[]
}

model Membership {
  id          String   @id @default(cuid())
  role        Role
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(AGENT)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  workspaceId String
  invitedById String
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

model WidgetSettings {
  id             String   @id @default(cuid())
  publicKey      String   @unique
  allowedOrigins String[]
  welcomeMessage String   @default("Hi! How can we help?")
  accentColor    String   @default("#1d5c4a")
  workspaceId    String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Conversation {
  id           String             @id @default(cuid())
  status       ConversationStatus @default(OPEN)
  channel      Channel            @default(WIDGET)
  visitorId    String
  visitorEmail String?
  subject      String?
  assigneeId   String?
  workspaceId  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?            @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  Message[]
  tags      ConversationTag[]

  @@index([workspaceId, status])
  @@index([workspaceId, visitorId])
}

model Message {
  id             String        @id @default(cuid())
  author         MessageAuthor
  body           String
  isInternal     Boolean       @default(false)
  conversationId String
  authorUserId   String?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser   User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model Tag {
  id          String   @id @default(cuid())
  name        String
  workspaceId String
  createdAt   DateTime @default(now())

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([workspaceId, name])
}

model ConversationTag {
  conversationId String
  tagId          String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model KnowledgeDocument {
  id          String   @id @default(cuid())
  title       String
  sourceName  String?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]
}

model DocumentChunk {
  id          String                       @id @default(cuid())
  content     String
  position    Int
  embedding   Unsupported("vector(1536)")?
  documentId  String
  workspaceId String
  createdAt   DateTime                     @default(now())

  document  KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([workspaceId])
}

model Subscription {
  id                   String             @id @default(cuid())
  plan                 Plan               @default(STARTER)
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  seatLimit            Int                @default(1)
  aiQuota              Int                @default(50)
  workspaceId          String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsageCounter {
  id                String   @id @default(cuid())
  period            String
  aiSuggestionsUsed Int      @default(0)
  workspaceId       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period])
}

model Integration {
  id          String          @id @default(cuid())
  type        IntegrationType
  credentials String
  workspaceId String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type])
}
